{
  "name": "@arena/arena-agent",
  "version": "0.1.0",
  "description": "Arena Hero 编排层（决策层）：游戏循环、共享地图、策略、遥测、supervisor。TS 版，直接嵌入 pi-coding-agent。",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-sim-isolation.ts && node scripts/check-test-count.mts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:fast": "node --test \"test/**/*.test.ts\"",
    "arena:doctor": "tsx src/cli/run-tenant.ts --doctor",
    "arena:shadow": "tsx src/cli/run-tenant.ts",
    "arena:live": "tsx src/cli/run-tenant.ts --live",
    "arena:sim": "tsx src/cli/run-sim.ts",
    "sim:doctor": "tsx src/cli/run-sim.ts doctor",
    "sim:run": "tsx src/cli/run-sim.ts episode",
    "sim:ab": "tsx src/cli/run-sim.ts ab",
    "sim:bench": "tsx src/cli/run-sim.ts benchmark",
    "sim:calibrate": "tsx src/cli/run-sim.ts calibrate",
    "sim:isolation-check": "node scripts/check-sim-isolation.ts",
    "sim:test": "node --test \"test/**/sim-*.test.ts\"",
    "sim:calibrate-dataset": "tsx src/cli/run-sim.ts calibrate-dataset",
    "sim:dataset": "tsx src/cli/run-sim.ts dataset",
    "arena:supervisor": "tsx src/cli/run-supervisor.ts",
    "arena:config-preflight": "tsx scripts/config-preflight.ts",
    "sim:variant-window": "tsx scripts/variant-window.mts",
    "sim:evolve:macro": "tsx scripts/evolve-macro-policy.mts",
    "sim:audit-evolution": "tsx scripts/audit-evolution-dimensions.mts",
    "sim:calibrate-world": "tsx scripts/calibrate-world.mts",
    "survey:sync": "tsx scripts/run-survey-sync.mts"
  },
  "dependencies": {
    "@arena/arena-hero-ts": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-agent-core": "^0.83.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
