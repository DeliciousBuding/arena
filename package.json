{
  "name": "arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arena Hero TS-only safe autonomous runtime and simulator",
  "scripts": {
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test",
    "schema:check": "node packages/arena-hero-ts/scripts/generate-schemas.ts && git diff --exit-code -- packages/arena-hero-ts/contracts/ && tsx scripts/check-shared-schemas.ts",
    "replay:ts": "npx tsx packages/arena-agent/scripts/replay-ts.ts --manifest fixtures/differential/burnin-20260802-a/manifest.json --fixture-dir fixtures/differential/burnin-20260802-a --out /tmp/replay-ts.jsonl",
    "arena:supervisor": "tsx packages/arena-agent/src/cli/run-supervisor.ts",
    "server:healthcheck": "tsx scripts/server/healthcheck.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.4"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=8.9.0 <9"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
