[Unit]
Description=Arena multi-tenant supervisor (shadow, Docker, auto-recoverable)
Documentation=file:/opt/arena/current/docs/ops/server-deployment.md
Wants=network-online.target docker.service
After=network-online.target docker.service
Conflicts=arena-supervisor-live.service
ConditionPathIsDirectory=/opt/arena/current
ConditionPathIsDirectory=/etc/arena/configs
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/arena/current
Environment=PATH=/usr/bin:/bin
EnvironmentFile=/etc/arena/arena.env
EnvironmentFile=-/etc/arena/health.env
# Docker CLI runs as root; the container itself drops to uid 1001 (arena) via compose.
# --abort-on-container-exit --exit-code-from: propagate the container's exit code to
# systemd so Restart=on-failure actually fires when the container dies.
ExecStart=/usr/bin/docker compose -f /opt/arena/current/deploy/docker/arena-compose.yml up --abort-on-container-exit --exit-code-from shadow shadow
ExecStop=/usr/bin/docker compose -f /opt/arena/current/deploy/docker/arena-compose.yml down
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=64 78
TimeoutStartSec=120
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arena-supervisor-shadow

[Install]
WantedBy=multi-user.target
