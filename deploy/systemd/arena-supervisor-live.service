[Unit]
Description=Arena multi-tenant supervisor (deterministic live, Docker, manual recovery)
Documentation=file:/opt/arena/current/docs/ops/server-deployment.md
Wants=network-online.target docker.service
After=network-online.target docker.service
Conflicts=arena-supervisor-shadow.service
ConditionPathIsDirectory=/opt/arena/current
ConditionPathIsDirectory=/etc/arena/configs
OnFailure=arena-live-alert.service

[Service]
Type=simple
WorkingDirectory=/opt/arena/current
Environment=PATH=/usr/bin:/bin
EnvironmentFile=/etc/arena/arena.env
EnvironmentFile=-/etc/arena/health.env
# Docker CLI runs as root; the container itself drops to uid 1001 (arena) via compose.
ExecStart=/usr/bin/docker compose -f /opt/arena/current/deploy/docker/arena-compose.yml up live
ExecStop=/usr/bin/docker compose -f /opt/arena/current/deploy/docker/arena-compose.yml down
Restart=no
TimeoutStartSec=120
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arena-supervisor-live

[Install]
WantedBy=multi-user.target
