[Unit]
Description=Arena multi-tenant supervisor (deterministic live, manual recovery)
Documentation=file:/opt/arena/current/docs/ops/server-deployment.md
Wants=network-online.target
After=network-online.target
Conflicts=arena-supervisor-shadow.service
ConditionPathIsDirectory=/opt/arena/current
ConditionPathIsDirectory=/etc/arena/configs
OnFailure=arena-live-alert.service

[Service]
Type=simple
User=arena
Group=arena
WorkingDirectory=/opt/arena/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/arena
EnvironmentFile=/etc/arena/arena.env
EnvironmentFile=-/etc/arena/health.env
ExecStart=/opt/arena/current/scripts/server/run-supervisor.sh live
Restart=no
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=control-group
SendSIGKILL=yes
UMask=0077
StateDirectory=arena
StateDirectoryMode=0700
RuntimeDirectory=arena
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
TasksMax=256
LimitNOFILE=65536
MemoryMax=2G
CPUQuota=200%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arena-supervisor-live

[Install]
WantedBy=multi-user.target
