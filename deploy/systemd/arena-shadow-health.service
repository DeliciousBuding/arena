[Unit]
Description=Arena shadow readiness check (Docker)
After=arena-supervisor-shadow.service
OnFailure=arena-shadow-recover.service

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/bin
Environment=ARENA_DEBUG_PORT=8120
EnvironmentFile=-/etc/arena/health.env
ExecStart=/usr/bin/env bash /opt/arena/current/scripts/server/check-readiness.sh arena-supervisor-shadow.service shadow
NoNewPrivileges=true
