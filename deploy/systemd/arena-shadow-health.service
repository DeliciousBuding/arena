[Unit]
Description=Arena shadow readiness and disk health check
After=arena-supervisor-shadow.service
OnFailure=arena-shadow-recover.service

[Service]
Type=oneshot
User=arena
Group=arena
WorkingDirectory=/opt/arena/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ARENA_DEBUG_PORT=8120
Environment=ARENA_RUNTIME_DIR=/var/lib/arena
Environment=ARENA_MIN_FREE_BYTES=1073741824
EnvironmentFile=-/etc/arena/health.env
ExecStart=/usr/bin/env node scripts/server/healthcheck.mjs --systemd-unit=arena-supervisor-shadow.service --url=http://127.0.0.1:${ARENA_DEBUG_PORT}/ready --runtime-dir=${ARENA_RUNTIME_DIR} --min-free-bytes=${ARENA_MIN_FREE_BYTES}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
