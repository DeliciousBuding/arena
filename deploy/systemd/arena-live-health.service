[Unit]
Description=Arena live readiness check (Docker)
After=arena-supervisor-live.service
OnFailure=arena-live-alert.service

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/bin
Environment=ARENA_DEBUG_PORT=8120
EnvironmentFile=-/etc/arena/health.env
ExecStart=/usr/bin/env bash /opt/arena/current/scripts/server/check-readiness.sh arena-supervisor-live.service live
NoNewPrivileges=true
