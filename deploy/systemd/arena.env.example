# Install as /etc/arena/arena.env with mode 0600 and root ownership.
# systemd reads this file and passes variables to the unprivileged arena service.

ARENA_REPO_ROOT=/opt/arena/current
ARENA_CONFIG_DIR=/etc/arena/configs
ARENA_CONFIGS=t1,t2,t3,t4
ARENA_SHUTDOWN_TIMEOUT_MS=15000
ARENA_STARTUP_SYNC_TICKS=1

# Tenant secrets: fill values only on the server. Never commit the completed file.
# ARENA_HERO_API_KEY_1=
# ARENA_HERO_API_KEY_2=
# ARENA_HERO_API_KEY_3=
# ARENA_HERO_API_KEY_4=
