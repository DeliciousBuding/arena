[Unit]
Description=Arena runtime filesystem free-space check (Docker)
OnFailure=arena-disk-alert.service

[Service]
Type=oneshot
Environment=PATH=/usr/bin:/bin
Environment=ARENA_RUNTIME_DIR=/var/lib/arena
Environment=ARENA_MIN_FREE_BYTES=1073741824
EnvironmentFile=-/etc/arena/health.env
ExecStart=/usr/bin/env bash /opt/arena/current/scripts/server/check-disk.sh
NoNewPrivileges=true
