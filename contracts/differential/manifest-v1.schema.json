{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/contracts/differential/manifest-v1.schema.json",
  "title": "differential_manifest_v1",
  "description": "Differential fixture manifest v1（2A 产出，E1/E2 消费）。segments 驱动回放顺序，decision_config 单源注入。规范见 docs/differential-record-v1.md。",
  "type": "object",
  "required": [
    "protocol_version", "dataset_id", "source", "tenant_id",
    "segments", "gaps", "inputs", "map_mode", "decision_config", "config_hash"
  ],
  "additionalProperties": true,
  "properties": {
    "protocol_version": { "const": 1 },
    "dataset_id": { "type": "string" },
    "source": { "type": "string" },
    "tenant_id": { "type": "string" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "ticks"],
        "additionalProperties": false,
        "properties": {
          "segment_id": { "type": "string" },
          "ticks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["after", "before", "missing_count"],
        "additionalProperties": false,
        "properties": {
          "after": { "type": "integer" },
          "before": { "type": "integer" },
          "missing_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "size"],
        "additionalProperties": false,
        "properties": {
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "bad_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tick", "error"],
        "additionalProperties": false,
        "properties": {
          "tick": { "type": "integer" },
          "error": { "type": "string" }
        }
      }
    },
    "map_mode": { "enum": ["disabled", "frozen", "controlled"] },
    "decision_config": {
      "type": "object",
      "description": "两端（Python/TS runner）必须从本对象读取同一决策配置，禁止各自读默认值。",
      "additionalProperties": true
    },
    "config_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
