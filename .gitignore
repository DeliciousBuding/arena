# 秘钥与环境配置
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 运行时产物
logs/
alerts/
/telemetry/

# 外部克隆的 skill 仓库（独立版本管理）
.agents/
mapstore/

# pi 二开 worktree（独立 git 仓库，pi 主 clone 在 [pi-repo]）
pi-dev/

# Node（monorepo：根 + 各包）
node_modules/
packages/*/node_modules/
runs/

# 运行时产物（Canary/真机）——配置只含 env 名，遥测/manifest 脱敏后仍不进 git
runtime/
runs/run-*/n/

# 模拟器 worktree（独立分支，模拟器工程专用）
.worktrees/
