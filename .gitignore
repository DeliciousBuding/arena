# 秘钥与环境配置
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 运行时产物
logs/
alerts/
/telemetry/

# 外部克隆的 skill 仓库（独立版本管理）
.agents/
mapstore/

# pi 二开 worktree（独立 git 仓库，pi 主 clone 在 [pi-repo]）
pi-dev/

# 本仓库并行开发 worktree（独立分支/索引，不纳入主工作区）
.worktrees/

# Node（monorepo：根 + 各包）
node_modules/
packages/*/node_modules/
runs/

# 运行时产物（Canary/真机）——配置只含 env 名，遥测/manifest 脱敏后仍不进 git
runtime/
runs/run-*/n/
# 例外：arena-agent 源码目录 src/runtime/ 不是运行时产物（gitignore 的 runtime/ 会误匹配任意层级）
!packages/arena-agent/src/runtime/
# 例外：alliance runtime shadow primitives 是源码不是运行时产物（同上）
!packages/arena-agent/src/alliance/runtime/
!packages/arena-agent/src/alliance/runtime/**

# 模拟器 worktree（独立分支，模拟器工程专用）
.worktrees/

# 生成物：status.md 的 SSOT 在协调根 docs/generated/（gen-status.py 直接写根仓；本地不再保留副本，2026-08-07）
docs/generated/

# command-center React 构建产物（随用随起，构建即生成）
packages/command-center/web/dist/
